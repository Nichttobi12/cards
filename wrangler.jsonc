{
  "name":"pokevault",
  "main":"worker/index.ts",
  "build":{"command":"npm run build"},
  "compatibility_date":"2026-05-15",
  "assets":{"directory":"./dist/client","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"pokevault","database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID","migrations_dir":"migrations"}],
  "triggers":{"crons":["* * * * *"]}
}
